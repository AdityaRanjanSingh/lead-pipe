{
  "buildCommand": "npm run build",
  "framework": "nextjs",
  "env": {
    "LANGGRAPH_DEPLOYMENT_URL": "@langgraph_deployment_url",
    "LANGSMITH_API_KEY": "@langsmith_api_key"
  },
  "build": {
    "env": {
      "LANGGRAPH_DEPLOYMENT_URL": "@langgraph_deployment_url",
      "LANGSMITH_API_KEY": "@langsmith_api_key"
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/copilotkit/:path*",
      "destination": "/api/copilotkit/:path*"
    }
  ],
  "regions": ["iad1"],
  "functions": {
    "src/app/api/**/*.ts": {
      "maxDuration": 60
    }
  }
}
